{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breaking Chains Rome Character",
  "type": "object",
  "required": ["id", "name", "role", "age_at_start", "origin", "legal_status", "languages", "survival_status", "classification"],
  "properties": {
    "id": {"type": "string", "pattern": "^CHAR-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "age_at_start": {"type": "integer", "minimum": 0, "maximum": 120},
    "origin": {"type": "string", "minLength": 1},
    "legal_status": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "survival_status": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
