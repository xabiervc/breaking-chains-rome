{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breaking Chains Rome Mission",
  "type": "object",
  "required": ["id", "title", "act", "date", "prerequisites", "locations", "success_state", "classification"],
  "properties": {
    "id": {"type": "string", "pattern": "^(ACT-ROME|SIDE-[A-Z]+)-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "act": {"type": "integer", "minimum": 1, "maximum": 4},
    "date": {"type": "string", "minLength": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "locations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^LOC-[A-Z]+-[0-9]{3}$"}},
    "success_state": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["FACT", "RECONSTRUCTION", "FICTION", "FICTION within historical framework", "FACT_RECONSTRUCTED_GAMEPLAY_ABSTRACTION"]}
  },
  "additionalProperties": true
}
