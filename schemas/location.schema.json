{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breaking Chains Rome Location",
  "type": "object",
  "required": ["id", "name", "region", "type", "languages", "security_level", "missions", "classification"],
  "properties": {
    "id": {"type": "string", "pattern": "^LOC-[A-Z]+-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "security_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "missions": {"type": "array", "items": {"type": "string"}},
    "classification": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
